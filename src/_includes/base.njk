<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% else %}<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <meta name="author" content="{{ site.name }}" />

  {% set ogImageUrl = "" %}
  {% if site.ogImage %}{% set ogImageUrl = site.ogImage if "://" in site.ogImage else site.url + site.ogImage %}{% endif %}

  <!-- Local / geo signals -->
  <meta name="geo.region" content="AU-QLD" />
  <meta name="geo.placename" content="Brisbane, Queensland" />
  <meta name="ICBM" content="{{ site.lat }}, {{ site.lng }}" />
  <meta name="theme-color" content="#FF5B1F" />

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ ogTitle if ogTitle else title }}" />
  {% if description %}<meta property="og:description" content="{{ ogDescription if ogDescription else description }}" />{% endif %}
  <meta property="og:type" content="{{ ogType if ogType else 'website' }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:locale" content="en_AU" />
  {% if ogImageUrl %}<meta property="og:image" content="{{ ogImageUrl }}" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ ogTitle if ogTitle else title }}" />{% endif %}

  <!-- Twitter -->
  <meta name="twitter:card" content="{% if ogImageUrl %}summary_large_image{% else %}summary{% endif %}" />
  <meta name="twitter:title" content="{{ ogTitle if ogTitle else title }}" />
  {% if description %}<meta name="twitter:description" content="{{ ogDescription if ogDescription else description }}" />{% endif %}
  {% if ogImageUrl %}<meta name="twitter:image" content="{{ ogImageUrl }}" />{% endif %}

  <!-- Icon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" />

  <link rel="stylesheet" href="/css/main.css" />
  {% if turnstile %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}

  <!-- Site-wide structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["Organization", "ProfessionalService"],
        "@id": "{{ site.url }}/#organization",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "logo": { "@type": "ImageObject", "url": "{{ site.url }}/favicon.svg" },
        "description": "{{ site.description }}",
        "email": "{{ site.email }}",
        "telephone": "{{ site.phone_office }}",
        "foundingDate": "{{ site.founded }}",
        "priceRange": "$$",
        "slogan": "More high-ticket jobs. Zero tyre kickers.",
        "address": { "@type": "PostalAddress", "addressLocality": "{{ site.address.city }}", "addressRegion": "{{ site.address.state }}", "addressCountry": "{{ site.address.country }}" },
        "geo": { "@type": "GeoCoordinates", "latitude": {{ site.lat }}, "longitude": {{ site.lng }} },
        "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "07:00", "closes": "18:00" },
        "areaServed": [{% for a in site.areaServed %}{ "@type": "City", "name": "{{ a }}" }{% if not loop.last %}, {% endif %}{% endfor %}],
        "knowsAbout": ["Google Ads for trades", "Meta advertising", "lead generation for home services", "landscaping marketing", "house washing marketing", "concreting marketing", "roofing marketing", "missed-call recovery", "local service ads"],
        "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %}, {% endif %}{% endfor %}],
        "contactPoint": { "@type": "ContactPoint", "telephone": "{{ site.phone_office }}", "email": "{{ site.email }}", "contactType": "sales", "areaServed": "AU", "availableLanguage": "English" }
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": "{{ site.name }}",
        "inLanguage": "en-AU",
        "publisher": { "@id": "{{ site.url }}/#organization" }
      }{% if page.url != "/" %},
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
          { "@type": "ListItem", "position": 2, "name": "{{ page.url | replace('/', '') | replace('-', ' ') | title }}", "item": "{{ site.url }}{{ page.url }}" }
        ]
      }{% endif %}
    ]
  }
  </script>

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xcebsrqlti");
  </script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EGM99MCRVN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-EGM99MCRVN');
  </script>
</head>
<body>

<!-- ============ HEADER ============ -->
<header class="site-header">
  <div class="nav-inner">
    <a class="logo" href="/">
      <span class="dot"></span>MARCUS<span class="slash">/</span>RESULTS
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}>Home</a></li>
        <li><a href="/services" {% if "/services" in page.url %}class="active"{% endif %}>How It Works</a></li>
        <li><a href="/pricing" {% if "/pricing" in page.url %}class="active"{% endif %}>Pricing</a></li>
        <li><a href="/about" {% if "/about" in page.url %}class="active"{% endif %}>About</a></li>
        <li><a href="/blog" {% if "/blog" in page.url %}class="active"{% endif %}>The Toolbox</a></li>
        <li><a href="/contact" {% if "/contact" in page.url %}class="active"{% endif %}>Contact</a></li>
      </ul>
    </nav>
    <a href="/contact" class="btn dark sm header-cta">Free Game Plan →</a>
    <button class="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="footer-grid">
    <div class="brand">
      <div class="display">MARCUS<span style="color:var(--orange)">/</span>RESULTS</div>
      <p>Marketing for home services businesses that actually want to grow. Brisbane, QLD.</p>
    </div>
    <div>
      <h4>Site</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/services">How It Works</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">The Toolbox</a></li>
      </ul>
    </div>
    <div>
      <h4>@marcusresults</h4>
      <ul>
        {% for s in site.social %}<li><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a></li>{% endfor %}
      </ul>
    </div>
    <div>
      <h4>Contact</h4>
      <ul>
        <li><a href="mailto:marcus@marcusresults.com">marcus@marcusresults.com</a></li>
        <li><a href="tel:0731139989">07 3113 9989</a></li>
        <li><a href="tel:0457765928">0457 765 928</a></li>
        <li>Brisbane, QLD</li>
      </ul>
    </div>
  </div>
  <div class="footer-meta">
    <span>© 2026 MARCUS RESULTS</span>
    <span>BRISBANE → AUSTRALIA WIDE</span>
  </div>
</footer>

<!-- ============ STICKY CTA ============ -->
<div class="sticky-cta">
  <div class="label">
    <span class="display">FREE GAME PLAN</span>
    <span class="mono">No pitch unless you want one.</span>
  </div>
  <a href="/contact" class="btn sm">Get Mine →</a>
</div>

<script src="/js/main.js"></script>
</body>
</html>
